APP_NAME="SoudaCore ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Riyadh
APP_URL=http://localhost:8000
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# Central (landlord) domain used to resolve the platform's own routes
# (registration, Super Admin console) as opposed to tenant subdomains.
CENTRAL_DOMAIN=soudacore.app

# Comma-separated real origins allowed to call this API cross-origin
# (see config/cors.php) — "*" (the default) is fine for local
# development; a real production deployment should list your real
# console origin(s) explicitly instead.
CORS_ALLOWED_ORIGINS=*

LOG_CHANNEL=stack
LOG_DAILY_DAYS=14
FILESYSTEM_DISK=local
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=soudacore
DB_USERNAME=soudacore
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
# Two separate logical database indices on the same Redis instance —
# general use (queue, default Redis facade calls) vs. the cache store
# specifically (config/cache.php) — so cache keys and general Redis
# usage never collide in the same keyspace.
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_FROM_ADDRESS="no-reply@soudacore.app"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30
REMEMBER_ME_TTL_DAYS=90

# TODO(ops): configure a real SMS gateway for OTP delivery (e.g. Unifonic,
# Msegat — both Saudi-market SMS providers). OTP generation/verification
# logic itself is fully implemented in app/Services/OtpService.php; only
# the outbound transport is a deployment-time credential.
OTP_SMS_DRIVER=log
OTP_LENGTH=6
OTP_TTL_MINUTES=5

FAILED_LOGIN_MAX_ATTEMPTS=5
FAILED_LOGIN_LOCKOUT_MINUTES=15
PASSWORD_HISTORY_LIMIT=5

# TODO(business): provider selection is a real business/deployment
# decision this project has never been given a mandate on (see
# docs/REPORTS_ANALYTICS_SPRINT.md and docs/PROJECT_STATUS.md's
# standing notes on this pattern). Leave AI_PROVIDER=none to run the
# AI Assistant on its real deterministic keyword-grounded answers only
# (no LLM). Set AI_PROVIDER=anthropic and a real ANTHROPIC_API_KEY to
# enable free-form, multi-turn LLM responses grounded in the same real
# data — see App\Services\Ai\AnthropicLlmProvider.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=1024

# A second real provider, built the same sprint the AI Assistant's own
# per-tenant provider_override was added (see docs/AI_ASSISTANT_SPRINT.md)
# — api.openai.com has never actually been reachable from this
# project's development sandbox (unlike api.anthropic.com), but the
# integration is real and its request shape is locked in by tests.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=1024

# Production Readiness: a real, generic webhook for error tracking —
# no vendor SDK required (composer install is blocked in this
# project's own sandbox, so none is vendored). Leave unset to rely on
# log-only error visibility (storage/logs/laravel.log) — a legitimate
# choice for a smaller deployment. See App\Services\ErrorTrackingService
# and docs/PRODUCTION_READINESS.md.
ERROR_TRACKING_WEBHOOK_URL=

# TODO(ops): optional — only needed if you configure FILESYSTEM_DISK=s3
# or point a Storage::disk('s3') call somewhere (e.g. real off-host
# backup replication — see docs/BACKUP_RESTORE_GUIDE.md). Works with
# any S3-compatible provider (AWS S3, DigitalOcean Spaces, MinIO,
# Cloudflare R2), not AWS-exclusive — set AWS_ENDPOINT for a
# non-AWS provider. Leave all blank if you don't use this disk.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
